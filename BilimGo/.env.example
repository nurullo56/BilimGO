BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321
DB_PATH=data/bilimgo.db
DEBUG=false

RELAY_INTERNAL_URL=http://127.0.0.1:8081
RELAY_INTERNAL_SECRET=change-me-to-random-secret
DELIVERY_TOKEN_TTL_SECONDS=600

USERBOT_API_ID=your_api_id
USERBOT_API_HASH=your_api_hash
USERBOT_SESSION_STRING=your_pyrogram_session_string

CLICK_SERVICE_ID=your_click_service_id
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SECRET_KEY=your_click_secret_key

PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_SECRET_KEY=your_payme_secret_key

ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5
AI_EVAL_POLL_INTERVAL_SECONDS=15
MENTOR_USERBOT_ID=
